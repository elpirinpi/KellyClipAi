# Carpeta local para SQLite, videos originales, miniaturas y clips procesados.
KELLYCLIP_DATA_DIR=data

# Supabase Auth. Usa la URL del proyecto y la clave publicable (o anon legacy).
# No uses ni compartas una clave service_role en el cliente ni en este archivo.
SUPABASE_URL=https://xhifdtvrjeabdzgfbloy.supabase.co
SUPABASE_ANON_KEY=sb_publishable_8djtPjGH7GKi_gstEtElTw_zGRDVDlR

# Orígenes Vite permitidos para la API local.
KELLYCLIP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Proveedor compatible: Groq, OpenAI, Anthropic, OpenRouter o
# Servidor local compatible. La clave de Ajustes se cifra localmente con DPAPI.
LLM_PROVIDER=Groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Para servidores locales compatibles con OpenAI, indica su URL /v1.
LLM_BASE_URL=

# faster-whisper ejecuta este modelo en CPU con compute_type=int8.
WHISPER_MODEL=small

# OAuth local. Registra estas URLs como redirect/callback en las apps de cada proveedor:
# http://127.0.0.1:8000/api/integrations/youtube/callback
# http://127.0.0.1:8000/api/integrations/tiktok/callback
# http://127.0.0.1:8000/api/integrations/instagram/callback
# http://127.0.0.1:8000/api/integrations/zoom/callback
KELLYCLIP_OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000
KELLYCLIP_FRONTEND_BASE_URL=http://127.0.0.1:5173
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# API keys de stock. B-roll solo se activa si el proveedor elegido tiene una clave.
BROLL_PROVIDER=Pexels
PEXELS_API_KEY=
PIXABAY_API_KEY=
